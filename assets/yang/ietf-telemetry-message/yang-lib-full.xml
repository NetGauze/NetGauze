<yang-library xmlns="urn:ietf:params:xml:ns:yang:ietf-yang-library">
  <module-set>
    <name>complete</name>

    <!-- ============================================================ -->
    <!-- TELEMETRY MESSAGE -->
    <!-- ietf-telemetry-message defines the structured top-level -->
    <!-- message. ietf-yang-push-telemetry-message augments it with -->
    <!-- YANG Push subscription metadata. -->
    <!-- ============================================================ -->

    <!-- Main telemetry message structure -->
    <module>
      <name>ietf-telemetry-message</name>
      <revision>2026-10-25</revision>
      <namespace>urn:ietf:params:xml:ns:yang:ietf-telemetry-message</namespace>
      <feature>network-node-manifest</feature>
      <feature>data-collection-manifest</feature>
    </module>
    <!-- Augments ietf-telemetry-message with YANG Push subscription
    metadata -->
    <module>
      <name>ietf-yang-push-telemetry-message</name>
      <revision>2026-10-25</revision>
      <namespace>urn:ietf:params:xml:ns:yang:ietf-yang-push-telemetry-message</namespace>
    </module>

    <!-- ============================================================ -->
    <!-- YANG PUSH NOTIFICATION STACK -->
    <!-- Modules forming the YANG Push notification infrastructure. -->
    <!-- ietf-yp-notification is the top-level notification envelope. -->
    <!-- ============================================================ -->

    <!-- Notification envelope: extends YANG Push with structured
    headers -->
    <module>
      <name>ietf-yp-notification</name>
      <revision>2025-02-24</revision>
      <namespace>urn:ietf:params:xml:ns:yang:ietf-yp-notification</namespace>
    </module>
    <!-- Direct imports by ietf-yp-notification -->
    <module>
      <name>ietf-system-capabilities</name>
      <revision>2022-02-17</revision>
      <namespace>urn:ietf:params:xml:ns:yang:ietf-system-capabilities</namespace>
    </module>
    <module>
      <name>ietf-notification-capabilities</name>
      <revision>2022-02-17</revision>
      <namespace>urn:ietf:params:xml:ns:yang:ietf-notification-capabilities</namespace>
    </module>

    <!-- YANG Push subscription model, imported by
    ietf-yang-push-telemetry-message -->
    <module>
      <name>ietf-yang-push</name>
      <revision>2019-09-09</revision>
      <namespace>urn:ietf:params:xml:ns:yang:ietf-yang-push</namespace>
      <!-- We are permissive with the features for testing purposes -->
      <feature>on-change</feature>
    </module>
    <!-- Augments ietf-yang-push with revision/semver metadata in push
    update headers -->
    <module>
      <name>ietf-yang-push-revision</name>
      <revision>2025-12-07</revision>
      <namespace>urn:ietf:params:xml:ns:yang:ietf-yang-push-revision</namespace>
    </module>
    <!-- Augments ietf-yang-push with observation timestamps in push
    update headers -->
    <module>
      <name>ietf-yp-observation</name>
      <revision>2026-05-11</revision>
      <namespace>urn:ietf:params:xml:ns:yang:ietf-yp-observation</namespace>
    </module>

    <!-- Base notification subscription model, imported by
    ietf-yang-push -->
    <module>
      <name>ietf-subscribed-notifications</name>
      <revision>2019-09-09</revision>
      <namespace>urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications</namespace>
      <!-- We are permissive with the features for testing purposes -->
      <feature>encode-json</feature>
      <feature>encode-xml</feature>
      <feature>configured</feature>
      <feature>subtree</feature>
      <feature>xpath</feature>
    </module>
    <!-- Augments ietf-subscribed-notifications for distributed
    notification sources -->
    <module>
      <name>ietf-distributed-notif</name>
      <revision>2026-04-13</revision>
      <namespace>urn:ietf:params:xml:ns:yang:ietf-distributed-notif</namespace>
    </module>
    <!-- Direct imports by ietf-subscribed-notifications -->
    <module>
      <name>ietf-netconf-acm</name>
      <revision>2018-02-14</revision>
      <namespace>urn:ietf:params:xml:ns:yang:ietf-netconf-acm</namespace>
    </module>
    <module>
      <name>ietf-restconf</name>
      <revision>2017-01-26</revision>
      <namespace>urn:ietf:params:xml:ns:yang:ietf-restconf</namespace>
    </module>

    <!-- Platform metadata carried in telemetry messages, imported by
    ietf-telemetry-message -->
    <module>
      <name>ietf-platform-manifest</name>
      <revision>2026-06-27</revision>
      <namespace>urn:ietf:params:xml:ns:yang:ietf-platform-manifest</namespace>
    </module>
    <!-- Direct import by ietf-platform-manifest -->
    <module>
      <name>ietf-yang-library</name>
      <revision>2019-01-04</revision>
      <namespace>urn:ietf:params:xml:ns:yang:ietf-yang-library</namespace>
    </module>

    <!-- ============================================================ -->
    <!-- YANG PUSH SUBSCRIPTION TRANSPORT -->
    <!-- Modules defining how notifications are delivered to receivers -->
    <!-- ============================================================ -->

    <!-- UDP transport for YANG Push subscriptions -->
    <module>
      <name>ietf-udp-notif-transport</name>
      <revision>2025-02-14</revision>
      <namespace>urn:ietf:params:xml:ns:yang:ietf-udp-notif-transport</namespace>
    </module>
    <!-- Direct imports by ietf-udp-notif-transport -->
    <module>
      <name>ietf-subscribed-notif-receivers</name>
      <revision>2024-02-01</revision>
      <namespace>urn:ietf:params:xml:ns:yang:ietf-subscribed-notif-receivers</namespace>
    </module>
    <module>
      <name>ietf-udp-client</name>
      <revision>2025-02-24</revision>
      <namespace>urn:ietf:params:xml:ns:yang:ietf-udp-client</namespace>
    </module>
    <module>
      <name>ietf-tls-client</name>
      <revision>2024-10-10</revision>
      <namespace>urn:ietf:params:xml:ns:yang:ietf-tls-client</namespace>
    </module>
    <!-- Direct imports by ietf-tls-client -->
    <module>
      <name>ietf-crypto-types</name>
      <revision>2024-10-10</revision>
      <namespace>urn:ietf:params:xml:ns:yang:ietf-crypto-types</namespace>
    </module>
    <module>
      <name>ietf-truststore</name>
      <revision>2024-10-10</revision>
      <namespace>urn:ietf:params:xml:ns:yang:ietf-truststore</namespace>
    </module>
    <module>
      <name>ietf-keystore</name>
      <revision>2024-10-10</revision>
      <namespace>urn:ietf:params:xml:ns:yang:ietf-keystore</namespace>
    </module>
    <module>
      <name>ietf-tls-common</name>
      <revision>2024-10-10</revision>
      <namespace>urn:ietf:params:xml:ns:yang:ietf-tls-common</namespace>
    </module>
    <!-- Direct import by ietf-tls-common -->
    <module>
      <name>iana-tls-cipher-suite-algs</name>
      <revision>2024-10-16</revision>
      <namespace>urn:ietf:params:xml:ns:yang:iana-tls-cipher-suite-algs</namespace>
    </module>

    <!-- ============================================================ -->
    <!-- SHARED YANG TYPES AND INFRASTRUCTURE -->
    <!-- Common types shared across the telemetry stack and the -->
    <!-- interface payload modules below -->
    <!-- ============================================================ -->

    <!-- Imported by ietf-telemetry-message,
    ietf-yang-push-telemetry-message, and ietf-yp-notification -->
    <module>
      <name>ietf-yang-types</name>
      <revision>2013-07-15</revision>
      <namespace>urn:ietf:params:xml:ns:yang:ietf-yang-types</namespace>
    </module>
    <!-- Imported by ietf-telemetry-message and ietf-yp-notification -->
    <module>
      <name>ietf-inet-types</name>
      <revision>2021-02-22</revision>
      <namespace>urn:ietf:params:xml:ns:yang:ietf-inet-types</namespace>
    </module>
    <!-- Datastore identity base types, imported by ietf-yang-push and
    ietf-yang-push-telemetry-message -->
    <module>
      <name>ietf-datastores</name>
      <revision>2018-02-14</revision>
      <namespace>urn:ietf:params:xml:ns:yang:ietf-datastores</namespace>
    </module>
    <!-- YANG Patch operations, imported by ietf-yang-push -->
    <module>
      <name>ietf-yang-patch</name>
      <revision>2017-02-22</revision>
      <namespace>urn:ietf:params:xml:ns:yang:ietf-yang-patch</namespace>
    </module>
    <!-- Module versioning, imported by ietf-yang-push-revision and
    ietf-yang-push-telemetry-message -->
    <module>
      <name>ietf-yang-revisions</name>
      <revision>2024-06-04</revision>
      <namespace>urn:ietf:params:xml:ns:yang:ietf-yang-revisions</namespace>
    </module>
    <!-- Semantic versioning for YANG modules, imported by
    ietf-yang-push-revision and ietf-yang-push-telemetry-message -->
    <module>
      <name>ietf-yang-semver</name>
      <revision>2024-07-02</revision>
      <namespace>urn:ietf:params:xml:ns:yang:ietf-yang-semver</namespace>
    </module>
    <!-- Structure extension for defining non-config data, imported by
    ietf-telemetry-message, ietf-yang-push-telemetry-message, and
    ietf-yp-notification -->
    <module>
      <name>ietf-yang-structure-ext</name>
      <revision>2020-06-17</revision>
      <namespace>urn:ietf:params:xml:ns:yang:ietf-yang-structure-ext</namespace>
    </module>
    <!-- Schema mount, imported by ietf-network-instance -->
    <module>
      <name>ietf-yang-schema-mount</name>
      <revision>2019-01-14</revision>
      <namespace>urn:ietf:params:xml:ns:yang:ietf-yang-schema-mount</namespace>
    </module>

    <!-- ============================================================ -->
    <!-- INTERFACE DATA MODEL -->
    <!-- Interface operational state and configuration; -->
    <!-- carried as the payload in YANG Push updates -->
    <!-- ============================================================ -->

    <!-- Main interface data model -->
    <module>
      <name>ietf-interfaces</name>
      <revision>2018-02-20</revision>
      <namespace>urn:ietf:params:xml:ns:yang:ietf-interfaces</namespace>
      <augmented-by
        xmlns="urn:ietf:params:xml:ns:yang:ietf-yang-library-augmentedby">
        ietf-ip</augmented-by>
      <augmented-by
        xmlns="urn:ietf:params:xml:ns:yang:ietf-yang-library-augmentedby">
        ietf-network-instance</augmented-by>
    </module>
    <!-- Augments ietf-interfaces with per-interface IP address
    configuration -->
    <module>
      <name>ietf-ip</name>
      <revision>2018-02-22</revision>
      <namespace>urn:ietf:params:xml:ns:yang:ietf-ip</namespace>
    </module>
    <!-- Augments ietf-interfaces with network instance (VRF) binding -->
    <module>
      <name>ietf-network-instance</name>
      <revision>2019-01-21</revision>
      <namespace>urn:ietf:params:xml:ns:yang:ietf-network-instance</namespace>
    </module>
    <!-- Interface type identities, imported by ietf-interfaces -->
    <module>
      <name>iana-if-type</name>
      <revision>2014-05-08</revision>
      <namespace>urn:ietf:params:xml:ns:yang:iana-if-type</namespace>
    </module>

  </module-set>
  <schema>
    <name>complete</name>
    <module-set>complete</module-set>
  </schema>
  <content-id>ietf-telemetry-message-full</content-id>
</yang-library>
<modules-state xmlns="urn:ietf:params:xml:ns:yang:ietf-yang-library">
  <module-set-id>34</module-set-id>
</modules-state>
